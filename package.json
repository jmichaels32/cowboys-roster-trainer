{
  "name": "player-decks",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build:native": "node scripts/build-native.mjs",
    "update:roster": "node scripts/update-roster.mjs",
    "update:patriots": "node scripts/update-roster.mjs --team=patriots",
    "update:college-marks": "node scripts/update-college-marks.mjs",
    "update:nfl-top-100": "node scripts/update-nfl-top-100.mjs",
    "verify:trivia": "node scripts/verify-trivia.mjs",
    "verify:nfl": "node scripts/verify-nfl.mjs",
    "verify:rosters": "node scripts/verify-rosters.mjs",
    "ios:sync": "npm run build:native && LANG=en_US.UTF-8 LC_ALL=en_US.UTF-8 cap sync ios",
    "ios:open": "npm run ios:sync && cap open ios",
    "ios:run": "npm run ios:sync && zsh scripts/run-ios-device.zsh",
    "verify": "npm run verify:trivia && npm run verify:nfl && npm run verify:rosters && npm run build:native && node scripts/verify-app.mjs"
  },
  "dependencies": {
    "@capacitor/core": "7.6.8",
    "@capacitor/ios": "7.6.8"
  },
  "devDependencies": {
    "@capacitor/cli": "7.6.8"
  }
}
